# Local-only Docker Compose settings. Change these values before starting services.
WORDPRESS_DB_NAME=portfolio
WORDPRESS_DB_USER=portfolio
WORDPRESS_DB_PASSWORD=change-me-local-only
WORDPRESS_DB_ROOT_PASSWORD=change-me-local-only
WORDPRESS_PORT=8080

# Shared public site URL and webhook secret. Keep the same values in apps/web/.env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REVALIDATION_SECRET=replace-with-a-long-random-value
PORTFOLIO_WP_HOME=http://localhost:8080