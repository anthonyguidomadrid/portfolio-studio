# Configure these as Railway service variables; database values should be references to the MySQL service.
WORDPRESS_DB_HOST=replace-with-railway-mysql-host
WORDPRESS_DB_NAME=replace-with-database-name
WORDPRESS_DB_USER=replace-with-database-user
WORDPRESS_DB_PASSWORD=replace-with-secret

# The canonical WordPress origin and the public frontend origin are different domains.
PORTFOLIO_WP_HOME=https://cms.example.com
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to the same random value as apps/web's REVALIDATION_SECRET.
REVALIDATION_SECRET=replace-with-a-long-random-value